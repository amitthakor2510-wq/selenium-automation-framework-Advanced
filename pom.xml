<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.automation</groupId>
  <artifactId>selenium-framework</artifactId>
  <version>1.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Run-time defaults — override on CLI e.g. -Dsite=demoqa -Dbrowser=chrome -->
    <site>demoqa</site>
    <suiteXmlFile>testng-suites/demoqa-regression.xml</suiteXmlFile>
    <browser>chrome</browser>
    <headless>false</headless>
    <human.pause.enabled>true</human.pause.enabled>
    <!-- Default is 2 to match src/test/resources/config/global.properties'
         retry.count=2 — this value is ALWAYS injected into the forked test
         JVM as -Dretry.count=... by surefire below (see
         systemPropertyVariables), even when nobody passes -Dretry.count on
         the CLI. ConfigReader checks System.getProperty() before the
         properties file, so whatever sits here always wins over
         global.properties' value, not just overrides it when explicitly
         set. Leaving this at 0 was why RetryAnalyzer.retry() always
         returned false immediately (count(0) < maxRetry(0) is false) even
         after RetryListener was correctly registered as an annotation
         transformer — the retry count itself was silently zeroed before
         RetryAnalyzer ever got a chance to run. Override per-run with
         -Dretry.count=N; this is only the fallback default. -->
    <retry.count>2</retry.count>

    <!-- Selenium Grid / Docker — mirrors global.properties' grid.enabled=false
         and grid.url defaults. MUST live here (and in surefire's
         systemPropertyVariables below) for the same reason retry.count does:
         the Dockerfile's ENTRYPOINT passes -Dgrid.enabled=$GRID_ENABLED and
         -Dgrid.url=$GRID_URL to `mvn test`, but that only reaches Maven's own
         JVM. Without an explicit systemPropertyVariables entry referencing
         ${grid.enabled}/${grid.url}, the forked surefire test JVM never sees
         either value, ConfigReader falls back to global.properties'
         grid.enabled=false, and DriverFactory tries to launch a local Chrome
         binary that does not exist in the (deliberately browser-less) test
         image — every containerized run fails immediately. -->
    <grid.enabled>false</grid.enabled>
    <grid.url>http://localhost:4444/wd/hub</grid.url>

    <!-- Allure + AspectJ versions -->
    <allure.version>2.27.0</allure.version>
    <aspectj.version>1.9.25</aspectj.version>

    <!-- OWASP dependency-check version — see the "security" profile below.
         Kept as its own property (not inlined) so it can be bumped without
         hunting through the profile block. -->
    <dependency-check.version>10.0.4</dependency-check.version>

    <!-- Lombok — pinned explicitly (previously undeclared even though
         RegistrationPage.java uses @Getter, so it was resolving from an
         unpinned transitive version). 1.18.30+ is required for JDK 21+:
         older versions crash the compiler itself with
         "NoSuchFieldError: JCTree$JCImport ... qualid" because JDK 21
         changed that internal field's type and old Lombok reflects into
         it assuming the pre-21 type. -->
    <lombok.version>1.18.46</lombok.version>

    <!-- WebDriverManager — cache drivers so they are not re-downloaded every run.
         These must live here (not just in systemPropertyVariables) so they take
         effect before the forked test JVM spins up. -->
    <wdm.cachePath>${user.home}/.wdm</wdm.cachePath>
    <wdm.forceDownload>false</wdm.forceDownload>

    <!-- Firefox binary path. Leave empty to let geckodriver auto-detect Firefox.
         Override on CLI: -Dfirefox.binary=/usr/bin/firefox
         Common paths:
           Linux apt:   /usr/bin/firefox
           Linux snap:  /snap/bin/firefox
           macOS:       /Applications/Firefox.app/Contents/MacOS/firefox
           Windows:     C:\Program Files\Mozilla Firefox\firefox.exe        -->
    <firefox.binary></firefox.binary>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Allure BOM — keeps all allure module versions in sync automatically -->
      <dependency>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-bom</artifactId>
        <version>${allure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Force a commons-io version new enough to have
           FileTimes.fromUnixTime (added in 2.12.0), which WebDriverManager's
           bundled commons-compress requires when extracting driver
           tar.gz/zip archives. Without this pin, poi-ooxml transitively
           pulls in an older commons-io that wins dependency mediation and
           shadows the one WebDriverManager actually needs, causing:
           NoSuchMethodError: FileTimes.fromUnixTime(long) at
           TarArchiveEntry.parseTarHeaderUnwrapped during driver setup. -->
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.16.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>

    <!-- Selenium -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>4.21.0</version>
    </dependency>

    <!-- SLF4J (logging backend for WebDriverManager etc.) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>

    <!-- TestNG -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.9.0</version>
      <scope>test</scope>
    </dependency>

    <!-- WebDriverManager -->
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <!-- Pinned at 6.3.4 (not left on a range/LATEST) specifically because
           this version is the first to default wdm.edgeDriverUrl to
           https://msedgedriver.microsoft.com/. Microsoft retired the old
           msedgedriver.azureedge.net CDN in mid-2025; 6.1.0 (previously
           pinned here) still pointed at the dead domain, causing
           UnknownHostException on every -Dbrowser=edge run. -->
      <version>6.3.4</version>
    </dependency>

    <!-- Extent Reports (custom HTML report) -->
    <dependency>
      <groupId>com.aventstack</groupId>
      <artifactId>extentreports</artifactId>
      <version>5.1.2</version>
    </dependency>

    <!-- Allure TestNG — auto-captures pass/fail/skip from TestNG lifecycle -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-testng</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Allure Java Commons — the @Step/@Attachment annotations and Allure
         lifecycle API. allure-testng above only pulls this in with
         scope=test, so it's invisible from src/main/java (e.g.
         HumanActions.java uses @Step). Declared explicitly here at the
         default (compile) scope so main code can use it too. Version is
         already pinned by the allure-bom import above. -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-java-commons</artifactId>
    </dependency>

    <!-- Lombok — compile-time only (generates code into .class files,
         never needed at runtime), hence scope=provided. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Excel (.xlsx, .xls) -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>

    <!-- Bridges Apache POI's internal logging (poi-ooxml logs through the
         Log4j2 API, not SLF4J) into this project's actual logging backend
         (slf4j-simple above). Without this, Log4j2 finds its API on the
         classpath (pulled in transitively by poi-ooxml) but no implementation
         bound to it, and falls back to its own bare console SimpleLogger —
         visible as this startup warning the moment any Excel test-data file
         (e.g. login.xlsx) is first read:
           ERROR StatusLogger Log4j2 could not find a logging implementation.
           Please add log4j-core to the classpath. Using SimpleLogger...
         Adding log4j-core directly (as that message suggests) would just
         stand up a second, independent logging backend side-by-side with
         slf4j-simple instead of unifying POI's logging into the one this
         project already uses — log4j-to-slf4j routes it into the existing
         backend instead. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-to-slf4j</artifactId>
      <version>2.23.1</version>
    </dependency>

    <!-- CSV -->
    <dependency>
      <groupId>com.opencsv</groupId>
      <artifactId>opencsv</artifactId>
      <version>5.9</version>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.1</version>
    </dependency>

    <!-- YAML (DDT data files) -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
    </dependency>

    <!-- REST Assured — API testing (BookStoreApiTest hits DemoQA's BookStore/Account REST API) -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>

    <!-- axe-core — accessibility (WCAG/GIGW-adjacent) scanning, see
         core/utils/AccessibilityUtils.java. Version pinned against what was
         current at time of writing; this sandbox has no access to Maven
         Central so it hasn't been build-verified here — run
         `mvn dependency:resolve` locally and bump if this version has since
         been superseded. -->
    <dependency>
      <groupId>com.deque.html.axe-core</groupId>
      <artifactId>selenium</artifactId>
      <version>4.9.1</version>
    </dependency>

    <!-- AShot — pixel-level visual regression screenshots/diffing, see
         core/utils/VisualRegressionUtils.java. Same build-verification
         caveat as axe-core above applies. -->
    <dependency>
      <groupId>ru.yandex.qatools.ashot</groupId>
      <artifactId>ashot</artifactId>
      <version>1.5.4</version>
    </dependency>

    <!-- Appium — mobile automation scaffold, see mobile/core/AppiumDriverFactory.java
         and mobile/README.md. Same build-verification caveat as axe-core above
         applies. Compile scope (not test) since AppiumDriverFactory lives
         under src/main, matching how selenium-java itself is scoped above. -->
    <dependency>
      <groupId>io.appium</groupId>
      <artifactId>java-client</artifactId>
      <version>9.3.0</version>
    </dependency>

  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.qameta.allure</groupId>
          <artifactId>allure-maven</artifactId>
          <version>2.12.0</version>
          <configuration>
            <reportVersion>${allure.version}</reportVersion>
            <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
            <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Maven Compiler Plugin — previously undeclared, which meant
           Maven silently fell back to its ancient bundled default
           (3.1, from 2013). That default's javac invocation is what
           was crashing against modern JDKs. Pinning a current version
           here fixes that regardless of which JDK the CI agent uses.
           Lombok is also registered explicitly as an annotation
           processor path: relying on classpath auto-discovery for
           annotation processors is deprecated behavior and outright
           stops working on JDK 23+, so this keeps the build correct
           going forward too. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
          </suiteXmlFiles>
          <systemPropertyVariables>
            <site>${site}</site>
            <browser>${browser}</browser>
            <headless>${headless}</headless>
            <human.pause.enabled>${human.pause.enabled}</human.pause.enabled>
            <retry.count>${retry.count}</retry.count>
            <!-- Selenium Grid / Docker — see the grid.enabled/grid.url comment
                 in <properties> above for why these must be listed explicitly. -->
            <grid.enabled>${grid.enabled}</grid.enabled>
            <grid.url>${grid.url}</grid.url>
            <!-- WDM cache — prevents re-downloading drivers on every run -->
            <wdm.cachePath>${wdm.cachePath}</wdm.cachePath>
            <wdm.forceDownload>${wdm.forceDownload}</wdm.forceDownload>
            <!-- Firefox binary path (empty = auto-detect) -->
            <firefox.binary>${firefox.binary}</firefox.binary>
          </systemPropertyVariables>
          <testFailureIgnore>true</testFailureIgnore>
          <!-- AspectJ weaver is required for @Step and @Attachment annotations to work.
               java.util.logging.config.file points at src/test/resources/logging.properties,
               which silences Selenium's own harmless "Unable to find CDP implementation
               matching <version>" warnings that fire whenever the installed Chrome is newer
               than this Selenium release's bundled CDP command classes. @{jacocoArgLine} is
               populated by the jacoco-maven-plugin's prepare-agent execution below — it must
               come from that property (not the default "argLine") because this whole element
               is a literal, hardcoded <argLine>, not a reference to @{argLine}; using the
               default property name would have silently replaced everything below instead
               of adding to it. -->
          <argLine>
            @{jacocoArgLine}
            "-javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
            "-Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties"
            -Xms256m
            -Xmx2048m
            -XX:+UseG1GC
          </argLine>
          <!-- SCALABILITY: TestNG's own suite-level parallel="classes"
               thread-count="3" (see testng-suites/*.xml) runs inside this
               ONE forked JVM — Surefire itself still only forks 1 process
               (the default), which is correct here: TestNG manages its own
               thread pool for the classes/methods in a <suite>, so a
               second layer of Surefire-level forking/threadCount would just
               add JVM startup overhead without adding real concurrency.
               What DOES need to grow for 3 concurrent WebDriver sessions in
               one JVM is heap (bumped to -Xmx2048m above, from 1024m) — each
               session carries its own Selenium client-side buffers, log
               entries (goog:loggingPrefs captures full browser console
               logs per session), and Allure/Extent reporting state. Raise
               this together with testng-suites' thread-count and
               docker-compose.yml's SE_NODE_MAX_SESSIONS if you increase
               parallelism further. -->
          <parallel>none</parallel>
          <environmentVariables>
            <MOZ_DISABLE_CONTENT_SANDBOX>1</MOZ_DISABLE_CONTENT_SANDBOX>
          </environmentVariables>
        </configuration>
        <dependencies>
          <!-- AspectJ weaver must be on surefire's own classpath so it can instrument @Step -->
          <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
          </dependency>
        </dependencies>
      </plugin>

      <!-- Allure Maven plugin — lets you run: mvn allure:serve or mvn allure:report -->
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>2.12.0</version>
        <configuration>
          <reportVersion>${allure.version}</reportVersion>
          <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
          <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
        </configuration>
        <executions>
          <execution>
            <id>allure-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo — code coverage. prepare-agent writes its runtime agent
           flags into the jacocoArgLine property instead of the usual
           argLine, because surefire above already hardcodes a literal
           <argLine> (aspectj weaver + JUL config + heap flags) rather than
           referencing @{argLine} — using the default property name would
           silently overwrite that instead of appending to it. Report is
           bound to the test phase (like Allure above) so `mvn test`
           produces target/site/jacoco/index.html without needing a
           separate `mvn verify`. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <propertyName>jacocoArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Checkstyle — enforces checkstyle.xml (project root), which
           mirrors what .idea/checkstyle-idea.xml already checks in the
           IDE. Bound to the verify phase rather than test: `mvn test`
           (the command used everywhere else in this project — CI included)
           stays exactly as fast and unblocked as it is today; `mvn verify`
           is the opt-in gate. violationSeverity=warning + failsOnError
           means it fails the verify build on real problems (unused
           imports, missing braces, etc.) without demanding full Javadoc
           coverage. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Opt-in performance smoke check — deliberately a profile, not a plugin
       under <build><plugins>, so `mvn test` (used everywhere else in this
       project, CI included) is completely unaffected by its presence. Run
       explicitly with:
         mvn verify -Pperf
         mvn verify -Pperf -Dthreads=10 -DrampUp=5 -Dloops=5 -DmaxResponseMs=3000
       See perf/basic-smoke.jmx — this is a response-time smoke check
       (a handful of threads, response-code + duration assertions), NOT a
       load/capacity test. Results land in target/jmeter/results/ and an
       HTML report in target/jmeter/reports/. -->
  <profiles>
    <profile>
      <id>perf</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.lazerycode.jmeter</groupId>
            <artifactId>jmeter-maven-plugin</artifactId>
            <version>3.8.0</version>
            <configuration>
              <testResultsTimestamp>false</testResultsTimestamp>
              <testFilesDirectory>${project.basedir}/perf</testFilesDirectory>
              <resultsDirectory>${project.build.directory}/jmeter/results</resultsDirectory>
              <generateReports>true</generateReports>
              <reportDirectory>${project.build.directory}/jmeter/reports</reportDirectory>
              <propertiesUser>
                <threads>${threads}</threads>
                <rampUp>${rampUp}</rampUp>
                <loops>${loops}</loops>
                <maxResponseMs>${maxResponseMs}</maxResponseMs>
              </propertiesUser>
            </configuration>
            <executions>
              <execution>
                <id>jmeter-tests</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>jmeter</goal>
                </goals>
              </execution>
              <execution>
                <id>jmeter-check-results</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>results</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <!-- Overridable via -Dthreads=... etc. — see perf/basic-smoke.jmx's
             User Defined Variables, which read these via __P(). -->
        <threads>5</threads>
        <rampUp>2</rampUp>
        <loops>3</loops>
        <maxResponseMs>5000</maxResponseMs>
      </properties>
    </profile>

    <!-- Opt-in dependency vulnerability scan (OWASP Dependency-Check),
         same pattern as the "perf" profile above: a profile, not a plugin
         under <build><plugins>, so `mvn test` (used everywhere else in
         this project, CI included) is completely unaffected by its
         presence, and CI doesn't silently start failing builds on a newly
         published CVE with no warning. Run explicitly with:
           mvn verify -Psecurity
           mvn verify -Psecurity -DfailBuildOnCVSS=7
         First run downloads/builds the NVD CVE database locally and is
         slow (several minutes); subsequent runs reuse the cached copy in
         ~/.m2/repository/org/owasp/dependency-check-data. Report lands at
         target/dependency-check-report.html. failBuildOnCVSS defaults to
         11 (i.e. never fails the build) so adopting this profile in CI is
         a deliberate, separate decision from just wanting the report —
         set it explicitly (7 is a common "fail on High/Critical" cutoff)
         once the team is ready to gate merges on it. -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check.version}</version>
            <configuration>
              <failBuildOnCVSS>${failBuildOnCVSS}</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
              </formats>
              <suppressionFiles>
                <suppressionFile>owasp-suppressions.xml</suppressionFile>
              </suppressionFiles>
            </configuration>
            <executions>
              <execution>
                <id>dependency-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <!-- 11 is above the maximum possible CVSS score (10), so this is
             effectively "report only, never fail" until a run explicitly
             overrides it, e.g. -DfailBuildOnCVSS=7. -->
        <failBuildOnCVSS>11</failBuildOnCVSS>
      </properties>
    </profile>
  </profiles>
</project>
