<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Load test(s) for the API-only jsonplaceholder site. See demoqa-perf.xml's
     comment for why perf suites are opt-in, single-threaded-at-the-JVM-level,
     and split one-suite-per-site (same -Dsite-is-a-single-JVM-property reasoning
     as api-tests.xml vs api-tests-jsonplaceholder.xml).
     Run explicitly: -Dsite=jsonplaceholder -DsuiteXmlFile=testng-suites/jsonplaceholder-perf.xml -->
<suite name="Performance Tests Suite - jsonplaceholder" parallel="none" thread-count="1">

  <test name="jsonplaceholder Performance Tests" preserve-order="false">
    <groups>
      <run>
        <include name="perf"/>
      </run>
    </groups>

    <classes>
      <class name="com.automation.sites.jsonplaceholder.perf.JsonPlaceholderApiPerfTest"/>
    </classes>

  </test>

</suite>
