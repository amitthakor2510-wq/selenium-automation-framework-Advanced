<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- BDD (Cucumber) suite. Run with:
       mvn test -Dsite=saucedemo -DsuiteXmlFile=testng-suites/saucedemo-bdd.xml
     Filter scenarios by tag: add -Dcucumber.filter.tags="@smoke and @saucedemo".
     data-provider-thread-count = number of scenarios run at once; each gets its own browser.
     Keep it <= docker-compose.yml's SE_NODE_MAX_SESSIONS (3). Set to 1 for sequential runs. -->
<suite name="SauceDemo BDD Suite" data-provider-thread-count="2">
  <test name="SauceDemo BDD Scenarios">
    <classes>
      <class name="com.automation.bdd.runner.CucumberRunnerTest"/>
    </classes>
  </test>
</suite>
