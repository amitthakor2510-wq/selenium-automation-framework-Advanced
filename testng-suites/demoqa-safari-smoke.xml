<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- SAFARI VARIANT — parallel="none" is not a style choice here, it's a
     hard requirement. Only one SafariDriver session may exist on a
     machine at a time (a WebKit/Apple limitation — see the class javadoc
     on DriverFactory.createSafariDriver()); the thread-count="3" the
     plain demoqa-smoke.xml uses would have two classes race for that one
     session and fail outright. Everything else (groups/packages) is
     identical to demoqa-smoke.xml — this file exists purely to swap the
     parallel strategy, not to run a different slice of tests.
     Run with: -Dbrowser=safari -DsuiteXmlFile=testng-suites/demoqa-safari-smoke.xml
     (no -Dheadless — Safari has no headless mode; DriverFactory warns and
     continues if one is passed anyway). macOS only. -->
<suite name="DemoQA Safari Smoke Suite" parallel="none">

  <!-- RetryListener is an IAnnotationTransformer — must be registered here
       (or via ServiceLoader), not via @Listeners on a test class, or it
       silently never fires. See BaseTest.java for the full explanation. -->
  <listeners>
    <listener class-name="com.automation.sites.listeners.RetryListener"/>
  </listeners>

  <test name="DemoQA Safari Smoke Tests" preserve-order="true">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>

    <packages>
      <package name="com.automation.sites.demoqa.tests"/>
    </packages>

  </test>

</suite>
