<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The demoqa API tests, run OFFLINE against the in-process WireMock server instead of the real
     demoqa.com — no network, no rate limits, no accounts created on the live database.

       mvn test -Dsite=demoqa -DsuiteXmlFile=testng-suites/api-tests-mocked.xml -Dmock.enabled=true

     -Dmock.enabled=true is what points ApiConfig.baseUri() at WireMock (see
     core/mock/WireMockManager.java and docs/api-mocking.md). Without it, ApiResilienceMockedTest
     skips itself and the other two classes simply hit the real site, exactly like api-tests.xml.

     Same two classes as api-tests.xml plus ApiResilienceMockedTest, which forces error states
     (500s, a flaky-then-recovering endpoint, a slow response) that only a mock can produce.
     parallel="classes" is safe here: the mock's demoqa fake keeps per-account state under one
     lock, each class creates its own account, and ApiResilienceMockedTest only touches URLs under
     /__mock__/ that no other class uses. -->
<suite name="API Tests Suite - demoqa (mocked)" parallel="classes" thread-count="3">

  <listeners>
    <listener class-name="com.automation.sites.listeners.RetryListener"/>
  </listeners>

  <test name="Book Store API Tests (WireMock)" preserve-order="true">
    <groups>
      <run>
        <include name="api"/>
      </run>
    </groups>

    <classes>
      <class name="com.automation.sites.demoqa.tests.BookStoreApiTest"/>
      <class name="com.automation.sites.demoqa.tests.BookStoreApiNegativeTest"/>
      <class name="com.automation.sites.demoqa.tests.ApiResilienceMockedTest"/>
    </classes>

  </test>

</suite>
