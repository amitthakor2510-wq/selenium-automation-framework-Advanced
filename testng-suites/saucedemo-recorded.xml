<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Runs the recorded keyword test cases for saucedemo. Generated by RecorderCli.
     mvn test -Dsite=saucedemo -DsuiteXmlFile=testng-suites/saucedemo-recorded.xml -->
<suite name="saucedemo Recorded Keyword Suite" parallel="classes" thread-count="3">

  <listeners>
    <listener class-name="com.automation.sites.listeners.RetryListener"/>
  </listeners>

  <test name="saucedemo Recorded Keyword Tests" preserve-order="true">
    <classes>
      <class name="com.automation.sites.saucedemo.tests.RecordedSaucedemoKeywordTest"/>
    </classes>
  </test>

</suite>
