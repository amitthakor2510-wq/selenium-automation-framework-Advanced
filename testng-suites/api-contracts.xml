<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Provider verification of consumer contracts (Pact JSON in src/test/resources/contracts).
     See ContractVerificationRunner for the contract.* keys.
     Run: mvn test -Dsite=jsonplaceholder -DsuiteXmlFile=testng-suites/api-contracts.xml -->
<suite name="Consumer Contracts" parallel="none">
  <test name="Consumer Contracts" preserve-order="false">
    <classes>
      <class name="com.automation.core.api.generic.ContractVerificationRunner"/>
    </classes>
  </test>
</suite>
