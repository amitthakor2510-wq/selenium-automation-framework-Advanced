{
  "type": "performance",
  "title": "Performance test (JMeter)",
  "description": "Run an existing load test with your own virtual users, ramp-up and budgets.",
  "target": [
    {
      "id": "site",
      "label": "Site",
      "type": "site",
      "required": true,
      "siteSuites": "perf",
      "help": "Only sites that have a perf suite are offered."
    },
    {
      "id": "baseUrl",
      "label": "Base URL override",
      "type": "url",
      "required": false
    }
  ],
  "details": [
    {
      "id": "threads",
      "label": "Virtual users",
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 200,
      "default": 10
    },
    {
      "id": "rampUpSeconds",
      "label": "Ramp-up (seconds)",
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 600,
      "default": 5
    },
    {
      "id": "iterations",
      "label": "Iterations per user",
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 1000,
      "default": 5
    },
    {
      "id": "maxP99Millis",
      "label": "Max p99 response time (ms)",
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 120000,
      "default": 5000
    },
    {
      "id": "maxErrorRatePercent",
      "label": "Max error rate (%)",
      "type": "number",
      "required": true,
      "min": 0,
      "max": 100,
      "default": 1.0
    }
  ],
  "notes": "Large values put real load on the target. Only test systems you own or have permission to load-test."
}
