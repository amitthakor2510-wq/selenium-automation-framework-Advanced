{
  "type": "ui",
  "title": "UI test (browser)",
  "description": "Build a browser scenario step by step. It runs through the framework's keyword engine \u2014 no Java.",
  "target": [
    {
      "id": "site",
      "label": "Site",
      "type": "site",
      "required": true,
      "help": "Which configured site (pipeline-config.properties) the run targets."
    },
    {
      "id": "baseUrl",
      "label": "Base URL override",
      "type": "url",
      "required": false,
      "help": "Leave empty to use the site's own URL."
    },
    {
      "id": "browser",
      "label": "Browser",
      "type": "select",
      "options": [
        "chrome",
        "firefox",
        "edge"
      ],
      "default": "chrome"
    },
    {
      "id": "headless",
      "label": "Headless",
      "type": "checkbox",
      "default": true,
      "help": "No visible browser window. Turn off only when watching the run on a desktop."
    },
    {
      "id": "retryCount",
      "label": "Retries for failed tests",
      "type": "integer",
      "min": 0,
      "max": 5,
      "default": 0
    }
  ],
  "details": [
    {
      "id": "scenarioName",
      "label": "Scenario name",
      "type": "text",
      "required": true,
      "pattern": "^[A-Za-z][A-Za-z0-9_ -]{2,59}$",
      "help": "3-60 characters: letters, digits, space, - and _."
    },
    {
      "id": "steps",
      "label": "Steps",
      "type": "steps",
      "required": true,
      "min": 1,
      "max": 100,
      "help": "Locators look like id:user-name, css:.btn, xpath://button[@type='submit']. For passwords use ${secret:NAME} or ${env:NAME}, never the value itself."
    }
  ],
  "stepKeywords": {
