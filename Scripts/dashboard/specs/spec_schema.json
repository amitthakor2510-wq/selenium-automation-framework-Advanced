{
  "$comment": "Shape of a saved test spec. Per-type 'target' and 'details' contents are defined by wizard/forms/<type>.json and checked by wizard/validators.py; this file pins the envelope.",
  "type": "object",
  "required": ["version", "name", "type", "target", "details", "reports", "evidence", "run"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "name": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$" },
    "type": { "type": "string", "enum": ["ui", "api", "openapi", "performance", "crawler", "accessibility", "mobile"] },
    "target": { "type": "object" },
    "details": { "type": "object" },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allure": { "type": "boolean" },
        "extent": { "type": "boolean" },
        "summary": { "type": "boolean" },
        "pdf": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": { "type": "string", "enum": ["on-failure", "always", "never"] },
        "video": { "type": "boolean" },
        "aiNote": { "type": "boolean" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 240 }
      }
    },
    "meta": { "type": "object" }
  }
}
