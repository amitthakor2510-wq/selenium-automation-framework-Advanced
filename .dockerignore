target/
.git/
.idea/
*.iml
.vscode/
*.log
target/downloads/
target/debug-dumps/
target/allure-results/
target/allure-report/
target/extent-reports/
target/surefire-reports/

# Local secrets and tooling caches must never be baked into the image
# (COPY . . would otherwise copy .env with DASHBOARD_PASSWORD, plus ~60 MB of Allure CLI jars).
.env
*.env
.allure/
.m2/
.wdm/
allure-cli/
allure-report/
public/
__pycache__/
*.pyc
.android-sdk/

# Automation Console runtime state and credentials (gitignored, so they exist only on a dev machine):
# per-user PBKDF2 hashes, the encrypted secret store, and run workspaces (spec.json / run.log can embed
# internal URLs and test credentials). Both `COPY . .` (Dockerfile) and `COPY Scripts/dashboard/`
# (Dockerfile.dashboard) would otherwise bake them into an image layer.
Scripts/dashboard/auth/users.json
Scripts/dashboard/auth/secrets.enc.json
Scripts/dashboard/data/runs/
Scripts/dashboard/data/specs/
*.pem
*.key
